# Jira Cloud
JIRA_BASE_URL=https://lamnguyenadc1.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Example: only sync your MBA project tasks.
JIRA_JQL=project = MBA AND assignee = currentUser() ORDER BY updated DESC

# GitHub
GITHUB_REPOSITORY=Nguyen-Viet-Lam/QLDACNTT
GITHUB_TOKEN=github_pat_or_classic_token
